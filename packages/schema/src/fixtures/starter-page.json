{
  "schema": "stora.page",
  "version": "1.0.0",
  "metadata": {
    "title": "Welcome to KUBUILD",
    "description": "A starter template built with KUBUILD portable web builder",
    "author": "KUBUILD Team",
    "tags": ["landing-page", "starter", "portable"],
    "category": "landing",
    "version": "1.0.0",
    "createdAt": "2026-08-22T00:00:00.000Z",
