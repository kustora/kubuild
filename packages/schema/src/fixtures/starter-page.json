    },
    "children": [
      {
        "id": "hero-section",
        "type": "section",
        "props": {},
        "styles": {
          "base": {
            "paddingTop": "64px",
            "paddingBottom": "64px",
            "paddingLeft": "24px",
            "paddingRight": "24px",
            "backgroundColor": "#f8fafc"
          }
        },
        "children": [
          {
            "id": "hero-container",
            "type": "container",
            "props": {
              "maxWidth": "1200px"
            },
            "styles": {
              "base": {
                "margin": "0 auto",
                "display": "flex",
                "flexDirection": "column",
                "alignItems": "center",
                "textAlign": "center",
                "gap": "24px"
              }
            },
            "children": [
              {
                "id": "hero-heading",
