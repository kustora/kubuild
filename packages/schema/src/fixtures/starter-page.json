                "props": {
                  "text": "Build Once, Render Anywhere",
                  "level": 1
                },
                "styles": {
                  "base": {
                    "fontSize": "48px",
                    "fontWeight": "800",
                    "color": "#0f172a",
                    "lineHeight": "1.2"
