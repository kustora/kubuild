                  "mobile": {
                    "fontSize": "32px"
                  }
                },
                "children": []
              },
              {
                "id": "hero-text",
                "type": "text",
                "props": {
                  "content": "KUBUILD is an open, portable web page builder engine designed for modern web applications."
                },
                "styles": {
                  "base": {
                    "fontSize": "18px",
                    "color": "#475569",
                    "maxWidth": "680px",
                    "lineHeight": "1.6"
                  }
                },
                "children": []
              },
              {
                "id": "hero-image",
                "type": "image",
                "props": {
                  "src": "https://picsum.photos/200/300",
                  "asset": {
                    "type": "asset",
                    "assetId": "asset_hero_graphic",
                    "filename": "hero.webp",
                    "mimeType": "image/webp"
                  },
                  "alt": "KUBUILD Platform Graphic",
                  "width": 640,
                  "height": 360
                },
                "styles": {
                  "base": {
                    "borderRadius": "12px",
                    "maxWidth": "100%",
                    "height": "auto",
                    "boxShadow": "0 20px 25px -5px rgba(0, 0, 0, 0.1)"
                  }
                },
                "children": []
              },
              {
                "id": "hero-button",
                "type": "button",
                "props": {
                  "label": "Get Started",
                  "action": {
                    "type": "navigate",
                    "payload": {
                      "url": "/docs"
                    }
                  }
                },
                "styles": {
                  "base": {
                    "backgroundColor": "#2563eb",
                    "color": "#ffffff",
                    "paddingTop": "12px",
                    "paddingBottom": "12px",
                    "paddingLeft": "28px",
                    "paddingRight": "28px",
                    "borderRadius": "8px",
                    "fontWeight": "600",
                    "fontSize": "16px",
                    "cursor": "pointer",
                    "border": "none"
