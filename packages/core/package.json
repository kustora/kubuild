{
  "name": "@kubuild/core",
  "version": "0.10.2",
  "description": "Framework-agnostic engine for KUBUILD: document utilities, command engine, history, migration, and validation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && node ../../scripts/emit-cjs-dts.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kustora/kubuild.git",
    "directory": "packages/core"
  },
  "keywords": [
    "page-builder",
    "visual-editor",
    "low-code",
    "website-builder",
    "stora",
    "kubuild"
  ],
  "author": "KUBUILD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kustora/kubuild/issues"
  },
  "homepage": "https://github.com/kustora/kubuild#readme",
  "dependencies": {
    "@kubuild/schema": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^6.0.0",
    "vitest": "^3.0.5"
  }
}
