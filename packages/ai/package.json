{
  "name": "@kubuild/ai",
  "version": "0.10.0",
  "description": "Component-aware AI generation engine and adapters for KUBUILD",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/server/adapters/index.d.ts",
        "default": "./dist/server/adapters/index.js"
      },
      "require": {
        "types": "./dist/server/adapters/index.d.cts",
        "default": "./dist/server/adapters/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && node ../../scripts/emit-cjs-dts.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kustora/kubuild.git",
    "directory": "packages/ai"
  },
  "keywords": [
    "page-builder",
    "ai-generation",
    "website-builder",
    "stora",
    "kubuild",
    "llm",
    "gemini",
    "openai"
  ],
  "author": "KUBUILD",
  "license": "MIT",
  "dependencies": {
    "@kubuild/core": "workspace:*",
    "@kubuild/schema": "workspace:*"
  },
  "peerDependencies": {
    "@kubuild/components": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@kubuild/components": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kubuild/components": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^18.3.0",
    "react": "^19.3.0",
    "react-test-renderer": "^19.3.0",
    "tsup": "^8.3.6",
    "typescript": "^6.0.0",
    "vitest": "^3.0.5"
  }
}
