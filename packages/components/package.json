{
  "name": "@kubuild/components",
  "version": "0.2.0",
  "description": "Component registry and base definitions for KUBUILD",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./definitions": {
      "types": "./dist/definitions/index.d.ts",
      "import": "./dist/definitions/index.js",
      "require": "./dist/definitions/index.cjs"
    },
    "./traits": {
      "types": "./dist/traits/index.d.ts",
      "import": "./dist/traits/index.js",
      "require": "./dist/traits/index.cjs"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "import": "./dist/blocks/index.js",
      "require": "./dist/blocks/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kustora/kubuild.git",
    "directory": "packages/components"
  },
  "keywords": [
    "page-builder",
    "visual-editor",
    "low-code",
    "website-builder",
    "stora",
    "kubuild"
  ],
  "author": "KUBUILD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kustora/kubuild/issues"
  },
  "homepage": "https://github.com/kustora/kubuild#readme",
  "dependencies": {
    "@kubuild/core": "workspace:*",
    "@kubuild/schema": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^6.0.0",
    "vitest": "^3.0.5"
  }
}
