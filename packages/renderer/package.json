{
  "name": "@kubuild/renderer",
  "version": "0.0.1",
  "description": "Pure recursive React renderer for KUBUILD page documents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kustora/kubuild.git"
  },
  "keywords": [
    "page-builder",
    "visual-editor",
    "low-code",
    "website-builder",
    "stora",
    "kubuild"
  ],
  "author": "KUBUILD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kustora/kubuild/issues"
  },
  "homepage": "https://github.com/kustora/kubuild#readme",
  "dependencies": {
    "@kubuild/components": "workspace:*",
    "@kubuild/core": "workspace:*",
    "@kubuild/schema": "workspace:*",
    "lucide-react": "^1.33.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^6.0.0",
    "vitest": "^3.0.5"
  }
}
