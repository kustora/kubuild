{
  "name": "@kubuild/plugin-animation",
  "version": "0.1.0",
  "description": "Preset-driven animation generator effect plugins (entrance, loop, hover) for KUBUILD, powered by Motion",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dom": {
      "import": {
        "types": "./dist/dom.d.ts",
        "default": "./dist/dom.js"
      },
      "require": {
        "types": "./dist/dom.d.cts",
        "default": "./dist/dom.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && node ../../scripts/emit-cjs-dts.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kustora/kubuild.git",
    "directory": "packages/plugin-animation"
  },
  "keywords": [
    "page-builder",
    "animation",
    "motion",
    "scroll-animation",
    "website-builder",
    "stora",
    "kubuild"
  ],
  "author": "KUBUILD",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/kustora/kubuild/issues"
  },
  "homepage": "https://github.com/kustora/kubuild#readme",
  "dependencies": {
    "@kubuild/core": "workspace:*",
    "@kubuild/effect-kit": "workspace:*",
    "motion": "^14.12.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@kubuild/ai": "workspace:*",
    "@kubuild/schema": "workspace:*",
    "happy-dom": "^21.0.4",
    "tsup": "^8.3.6",
    "typescript": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
